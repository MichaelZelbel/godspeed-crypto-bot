[Unit]
Description=@DISPLAY@: weekly Hyperliquid terms check
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=@NAME@
Group=@NAME@
WorkingDirectory=@STATE@
Environment=PYTHONPATH=@CODE@
Environment=PYTHONUNBUFFERED=1
Environment=GODSPEED_CRYPTO_BOT_UNIT=%N
ImportCredential=@NAME@.*
ExecStart=@CODE@/.venv/bin/python -m godspeed_crypto_bot.cli terms-check
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=@STATE@
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=768M
CPUQuota=50%
UMask=0077
TimeoutStartSec=600
