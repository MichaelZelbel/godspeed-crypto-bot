[Unit]
Description=@DISPLAY@: daily decision and orders
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=@NAME@
Group=@NAME@
WorkingDirectory=@STATE@
Environment=PYTHONPATH=@CODE@
Environment=PYTHONUNBUFFERED=1
Environment=GODSPEED_CRYPTO_BOT_UNIT=%N
Environment=GODSPEED_CRYPTO_BOT_EVERY=86400
Environment=GODSPEED_CRYPTO_BOT_OFFSET=120
ImportCredential=@NAME@.*
ExecStart=@CODE@/.venv/bin/python -m godspeed_crypto_bot.cli run-daily
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=@STATE@
# The page (page.py); the dash: a missing directory is no reason not to trade.
ReadWritePaths=-@PAGE@
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=768M
CPUQuota=50%
UMask=0077
TimeoutStartSec=1800
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=120
